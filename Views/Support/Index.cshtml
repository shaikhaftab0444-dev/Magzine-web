@model IEnumerable<Digital_Magzine.Models.SupportTicket>

@{
    ViewData["Title"] = "Customer Support";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700; font-size: 0.72rem;">
                    HELP &amp; ASSISTANCE
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #2d3436; letter-spacing: -0.5px;">Customer Support Portal</h1>
            <p class="text-muted small mb-0">Need help with your subscription, magazine reading, or payment verification? Submit a ticket below.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 small d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div class="fw-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 small d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div class="fw-semibold">@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Left: Create Ticket Form -->
        <div class="col-12 col-lg-5">
            <div class="neumorphic-card p-4 p-md-5 h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="neumorphic-circle-sm" style="color: #0ea5e9;">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <h5 class="fw-bold mb-0" style="color: #2d3436;">Create New Ticket</h5>
                </div>
                <p class="text-muted small mb-4">Describe your inquiry and our editorial and customer care team will assist you promptly.</p>

                <form asp-controller="Support" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="subject" class="form-label small fw-bold" style="color: #2d3436;">Subject / Topic</label>
                        <input type="text" name="subject" id="subject" class="form-control neumorphic-input w-100" placeholder="e.g. VIP Subscription Question, Payment Proof" required />
                    </div>

                    <div class="mb-4">
                        <label for="message" class="form-label small fw-bold" style="color: #2d3436;">Message Details</label>
                        <textarea name="message" id="message" rows="5" class="form-control neumorphic-input w-100" placeholder="Provide full details regarding your question or request..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-neumorphic-primary w-100 py-3 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border: none;">
                        <i class="bi bi-send-fill me-2"></i> Submit Support Ticket
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Fast FAQ / Contact Help Card -->
        <div class="col-12 col-lg-7">
            <div class="neumorphic-card p-4 p-md-5 h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="neumorphic-circle-sm" style="color: #10b981;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-0" style="color: #2d3436;">Support Guidelines &amp; FAQs</h5>
                </div>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(200, 204, 214, 0.5);">
                        <div class="fw-bold small text-dark mb-1">
                            <i class="bi bi-qr-code text-primary me-1"></i> QR Payment Verification Timeline
                        </div>
                        <p class="text-muted small mb-0">
                            UPI &amp; QR payments submitted with a reference number are manually reviewed and activated within 15–30 minutes during standard business hours.
                        </p>
                    </div>

                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(200, 204, 214, 0.5);">
                        <div class="fw-bold small text-dark mb-1">
                            <i class="bi bi-journal-richtext text-success me-1"></i> Reading Issues Offline
                        </div>
                        <p class="text-muted small mb-0">
                            Subscribers can download full PDF issues directly from the PDF viewer toolbar or access past readings from their Reading History.
                        </p>
                    </div>

                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(200, 204, 214, 0.5);">
                        <div class="fw-bold small text-dark mb-1">
                            <i class="bi bi-envelope-paper text-warning me-1"></i> Direct Editorial Support
                        </div>
                        <p class="text-muted small mb-0">
                            You may also email us directly at <strong>@SettingsService.GetValue("ContactEmail", "editorial@cultureclub.com")</strong> for publisher partnerships.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Past Support Tickets Table -->
    <div class="neumorphic-card p-4 p-md-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h5 class="fw-bold mb-1" style="color: #2d3436;">Your Support History</h5>
                <p class="text-muted small mb-0">View the resolution progress and status of your previously submitted tickets.</p>
            </div>
            <span class="badge rounded-pill px-3 py-2 fw-bold" style="background: rgba(14, 165, 233, 0.15); color: #0284c7;">
                @Model.Count() Total Tickets
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-ticket-perforated fs-1 text-muted d-block mb-3"></i>
                <h6 class="fw-bold text-dark mb-1">No Support Tickets Submitted</h6>
                <p class="text-muted small mb-0">You have not submitted any customer support tickets yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="border-collapse: separate; border-spacing: 0 8px;">
                    <thead>
                        <tr class="text-muted small text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <th class="border-0 ps-3">Ticket #</th>
                            <th class="border-0">Subject</th>
                            <th class="border-0">Submitted</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 pe-3">Inquiry Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr style="background-color: rgba(255, 255, 255, 0.6); box-shadow: 2px 2px 6px rgba(0,0,0,0.02); border-radius: 12px;">
                                <td class="ps-3 fw-bold font-monospace" style="color: #0284c7;">
                                    #@ticket.Id
                                </td>
                                <td>
                                    <span class="fw-bold" style="color: #2d3436;">@ticket.Subject</span>
                                </td>
                                <td class="text-muted small">
                                    @ticket.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy &bull; hh:mm tt")
                                </td>
                                <td>
                                    @if (ticket.Status.Equals("Resolved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(16, 185, 129, 0.15); color: #059669; font-weight: 700;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Resolved
                                        </span>
                                    }
                                    else if (ticket.Status.Equals("Closed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(100, 116, 139, 0.15); color: #475569; font-weight: 700;">
                                            <i class="bi bi-slash-circle me-1"></i> Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(245, 158, 11, 0.15); color: #d97706; font-weight: 700;">
                                            <i class="bi bi-hourglass-split me-1"></i> Open &bull; In Review
                                        </span>
                                    }
                                </td>
                                <td class="pe-3">
                                    <div class="small text-secondary text-truncate" style="max-width: 320px;" title="@ticket.Message">
                                        @ticket.Message
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
