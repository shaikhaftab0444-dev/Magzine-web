@model Digital_Magzine.Models.CustomerDashboardViewModel

@{
    ViewData["Title"] = "Subscriber Dashboard";
    ViewData["IsDashboard"] = true;
}

<div class="cc-dashboard-wrapper neumorphic-theme">
    <!-- Left-Side Neumorphic Sidebar Navigation -->
    <aside class="cc-sidebar cc-sidebar-neumorphic">
        <div>
            <!-- Top: Pink CC Monogram Logo & CULTURE CLUB Text -->
            <a asp-controller="Customer" asp-action="Index" class="cc-sidebar-brand text-decoration-none">
                <span class="cc-monogram-pink">CC</span>
                <div>
                    <span class="cc-brand-title d-block" style="color: #2d3436; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.5px;">CULTURE CLUB</span>
                    <span class="cc-brand-subtitle d-block" style="color: #0ea5e9; font-weight: 700; font-size: 0.65rem;">SUBSCRIBER VIP</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <ul class="cc-nav-list">
                <li class="cc-nav-item">
                    <a asp-controller="Customer" asp-action="Index" class="cc-nav-link active">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="cc-nav-item">
                    <a asp-controller="Home" asp-action="Index" class="cc-nav-link">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Explore Newsstand</span>
                    </a>
                </li>
                <li class="cc-nav-item">
                    <a href="#readingActivity" class="cc-nav-link">
                        <i class="bi bi-clock-history"></i>
                        <span>Reading Activity</span>
                    </a>
                </li>
                <li class="cc-nav-item">
                    <a href="#subscriptionCard" class="cc-nav-link">
                        <i class="bi bi-credit-card"></i>
                        <span>Subscription</span>
                    </a>
                </li>
                <li class="cc-nav-item">
                    <a href="#quickActions" class="cc-nav-link">
                        <i class="bi bi-cloud-arrow-down"></i>
                        <span>Offline Downloads</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Sidebar Bottom: VIP Card & Utility Controls -->
        <div class="cc-sidebar-bottom">
            <div class="neumorphic-card p-3 mb-2" style="border-radius: 14px !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge rounded-pill" style="background: var(--neu-pink-gradient); color: white; font-weight: 700; font-size: 0.7rem;">
                        <i class="bi bi-award-fill me-1"></i> VIP PASS
                    </span>
                    <span class="small fw-bold text-success" style="font-size: 0.75rem;">Active</span>
                </div>
                <div class="small text-muted mb-1" style="font-size: 0.72rem;">Subscription Renews:</div>
                <div class="fw-bold small mb-2" style="color: #2d3436; font-size: 0.8rem;">
                    @(Model.ActiveSubscription != null ? Model.ActiveSubscription.EndDate.ToString("MMM dd, yyyy") : "Auto-Renewing")
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-neumorphic flex-grow-1 small py-2" title="Storefront">
                    <i class="bi bi-shop me-1"></i> Storefront
                </a>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                <button type="submit" class="btn btn-neumorphic w-100 text-danger small py-2">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="cc-dashboard-content">
        <!-- Header: Search bar left; Notification bell and profile right -->
        <div class="dashboard-header mb-4">
            <div class="dashboard-search-box">
                <i class="bi bi-search text-muted"></i>
                <input type="text" class="form-control dashboard-search-input neumorphic-input" placeholder="Search digital issues, magazines, topics..." />
            </div>

            <div class="d-flex align-items-center gap-3">
                <button type="button" class="neumorphic-circle-btn position-relative" aria-label="Notifications" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge-dot" style="background-color: #0ea5e9; border-color: #e6e9f0;"></span>
                </button>

                <div class="dropdown">
                    <button class="btn btn-neumorphic d-flex align-items-center gap-2 px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 50px !important;">
                        <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem; background: var(--neu-sky-gradient);">
                            <i class="bi bi-gem"></i>
                        </div>
                        <div class="text-start d-none d-sm-block">
                            <div class="small fw-bold lh-1" style="color: #2d3436;">@(User.Identity?.Name != null ? User.Identity.Name.Split('@')[0] : "Subscriber")</div>
                            <div class="small" style="color: #0ea5e9; font-size: 0.72rem; font-weight: 600;">VIP Subscriber</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted small ms-1"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" style="background-color: #ffffff; min-width: 200px;">
                        <li><h6 class="dropdown-header small fw-bold text-uppercase" style="color: #0ea5e9;">VIP Account</h6></li>
                        <li><a class="dropdown-item py-2 fw-semibold" href="#subscriptionCard"><i class="bi bi-card-checklist me-2 text-primary"></i>My Plan</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-journal-album me-2 text-success"></i>Browse Magazines</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 pt-1">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start rounded-pill">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 neumorphic-card text-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Neumorphic Hero Banner -->
        <div class="neumorphic-card p-4 p-md-5 mb-4">
            <div class="row align-items-center g-4">
                <div class="col-md-9 col-lg-8">
                    <span class="badge rounded-pill px-3 py-1 mb-3" style="background: var(--neu-pink-gradient); color: white; font-weight: 700; font-size: 0.75rem;">
                        <i class="bi bi-patch-check-fill me-1"></i> VIP ALL-ACCESS MEMBERSHIP
                    </span>
                    <h1 class="fw-bold mb-2" style="color: #2d3436; font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: -0.5px;">
                        Welcome back, @(User.Identity?.Name != null ? User.Identity.Name.Split('@')[0] : "VIP Member")!
                    </h1>
                    <p class="text-muted mb-4" style="max-width: 580px; font-size: 0.98rem; line-height: 1.5;">
                        You have unlimited digital access to thousands of premium magazines, offline flipbooks, and exclusive publisher releases.
                    </p>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-neumorphic-primary px-4 py-2">
                            Explore All Magazines &rarr;
                        </a>
                        <a href="#subscriptionCard" class="btn btn-neumorphic px-4 py-2">
                            Manage Subscription
                        </a>
                    </div>
                </div>
                <!-- Large Pink Award Icon Graphic on Right -->
                <div class="col-md-3 col-lg-4 text-center d-none d-md-block">
                    <div class="neumorphic-circle-btn mx-auto" style="width: 110px; height: 110px;">
                        <i class="bi bi-award-fill" style="font-size: 3.5rem; color: #0ea5e9;"></i>
                    </div>
                    <div class="fw-bold small mt-3" style="color: #2d3436; letter-spacing: 0.5px;">PREMIER SUBSCRIBER</div>
                </div>
            </div>
        </div>

        <!-- 4 Neumorphic Perk Boxes -->
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="neumorphic-card p-3 p-md-4 text-center h-100">
                    <div class="neumorphic-circle-sm mx-auto mb-2">
                        <i class="bi bi-infinity"></i>
                    </div>
                    <div class="fw-bold small mb-1" style="color: #2d3436;">Unlimited Access</div>
                    <div class="text-muted" style="font-size: 0.75rem;">All digital magazine titles</div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="neumorphic-card p-3 p-md-4 text-center h-100">
                    <div class="neumorphic-circle-sm mx-auto mb-2">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <div class="fw-bold small mb-1" style="color: #2d3436;">Multi-Device Sync</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Web, tablet & mobile</div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="neumorphic-card p-3 p-md-4 text-center h-100">
                    <div class="neumorphic-circle-sm mx-auto mb-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="fw-bold small mb-1" style="color: #2d3436;">Ad-Free Reading</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Distraction-free flipbook</div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="neumorphic-card p-3 p-md-4 text-center h-100">
                    <div class="neumorphic-circle-sm mx-auto mb-2">
                        <i class="bi bi-cloud-arrow-down"></i>
                    </div>
                    <div class="fw-bold small mb-1" style="color: #2d3436;">Offline Downloads</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Save & read anywhere</div>
                </div>
            </div>
        </div>

        <!-- Instant VIP Digital Reader & Shelf -->
        @if (Model.AvailableIssues != null && Model.AvailableIssues.Any())
        {
            <div class="neumorphic-card p-4 mb-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700; font-size: 0.72rem;">
                                VIP DIGITAL ACCESS
                            </span>
                        </div>
                        <h2 class="h5 fw-bold mb-0" style="color: #2d3436;">Your Digital Magazine Shelf</h2>
                        <span class="text-muted small">Open any issue in full-screen distraction-free PDF replica mode</span>
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-neumorphic btn-sm py-1 px-3 small">
                        Explore Full Newsstand &rarr;
                    </a>
                </div>

                <div class="row g-4">
                    @foreach (var issue in Model.AvailableIssues.Take(4))
                    {
                        var coverImg = !string.IsNullOrEmpty(issue.CoverImageUrl) 
                            ? issue.CoverImageUrl 
                            : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80";
                        var pub = "Culture Club Publishing";

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="p-3 rounded-4 h-100 d-flex flex-column justify-content-between" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(163, 177, 198, 0.25);">
                                <div>
                                    <div class="position-relative mb-3 rounded-3 overflow-hidden shadow-sm" style="aspect-ratio: 3/4;">
                                        <img src="@coverImg" alt="@issue.Title" class="w-100 h-100 object-fit-cover" />
                                        <span class="position-absolute top-0 start-0 m-2 badge rounded-pill" style="background: rgba(15, 23, 42, 0.85); color: white; font-size: 0.65rem;">
                                            Vol. @issue.Volume
                                        </span>
                                    </div>
                                    <h3 class="fw-bold fs-6 mb-1 text-truncate" title="@issue.Title" style="color: #2d3436;">@issue.Title</h3>
                                    <div class="text-muted small mb-3">@pub &bull; @issue.PublishDate.ToString("MMM yyyy")</div>
                                </div>
                                <a asp-controller="Reader" asp-action="Issue" asp-route-id="@issue.Id" target="_blank" class="btn btn-neumorphic-primary w-100 py-2 small fw-bold">
                                    <i class="bi bi-book-half me-1"></i> Read in HD &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Bottom Row: Reading Activity Bar Chart & Subscription Card -->
        <div class="row g-4 mb-4" id="readingActivity">
            <!-- Left: Reading Activity Chart -->
            <div class="col-12 col-lg-7">
                <div class="neumorphic-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="h5 fw-bold mb-0" style="color: #2d3436;">Your Reading Activity</h3>
                            <span class="text-muted small">Daily minutes spent reading Culture Club publications</span>
                        </div>
                        <span class="badge rounded-pill small" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700;">
                            Top 5% Reader
                        </span>
                    </div>

                    <div class="flex-grow-1" style="min-height: 230px;">
                        <canvas id="subscriberReadingChart" height="220"></canvas>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 mt-2 border-top" style="border-color: rgba(163, 177, 198, 0.3) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill small fw-bold" style="background: var(--neu-pink-gradient); color: white;">
                                <i class="bi bi-clock-history me-1"></i> 8.5 Hours
                            </span>
                            <span class="text-muted small">Total reading time this week (+2.1 hrs vs last week)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Subscription Status Card & Quick Actions -->
            <div class="col-12 col-lg-5 d-flex flex-column gap-3" id="subscriptionCard">
                <!-- Subscription Card -->
                <div class="neumorphic-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="neumorphic-circle-sm">
                                <i class="bi bi-gem"></i>
                            </div>
                            <h3 class="h6 fw-bold mb-0" style="color: #2d3436;">Your Active Plan</h3>
                        </div>
                        <span class="badge rounded-pill" style="background: rgba(4, 120, 87, 0.12); color: #047857; font-weight: 700;">
                            Active
                        </span>
                    </div>

                    @if (Model.ActiveSubscription != null && Model.ActiveSubscription.SubscriptionPlan != null)
                    {
                        var plan = Model.ActiveSubscription.SubscriptionPlan;
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <div class="h5 fw-bold mb-0" style="color: #2d3436;">@plan.Name</div>
                            <div class="h5 fw-bold mb-0" style="color: #0284c7;">@SettingsService.GetCurrencySymbol()@plan.Price.ToString("0.##") <span class="text-muted small fw-normal">/ mo</span></div>
                        </div>
                        <div class="text-muted small mb-3">
                            Renews on <strong style="color: #2d3436;">@Model.ActiveSubscription.EndDate.ToString("MMMM dd, yyyy")</strong>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <div class="h5 fw-bold mb-0" style="color: #2d3436;">@SettingsService.GetValue("BrandName", "Culture Club") Premium VIP</div>
                            <div class="h5 fw-bold mb-0" style="color: #0284c7;">@SettingsService.GetCurrencySymbol()499.00 <span class="text-muted small fw-normal">/ mo</span></div>
                        </div>
                        <div class="text-muted small mb-3">
                            All-Access Digital Edition &bull; Renews on <strong style="color: #2d3436;">Dec 31, 2026</strong>
                        </div>
                    }

                    <a asp-controller="Home" asp-action="Index" class="btn btn-neumorphic-primary w-100 py-2">
                        Browse Digital Newsstand &rarr;
                    </a>
                </div>

                <!-- Quick Actions List -->
                <div class="neumorphic-card p-4 flex-grow-1" id="quickActions">
                    <h4 class="h6 fw-bold mb-3" style="color: #2d3436;">Quick Features</h4>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background-color: rgba(255, 255, 255, 0.5);">
                            <div class="neumorphic-circle-sm">
                                <i class="bi bi-phone"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="small fw-bold" style="color: #2d3436;">Mobile & Tablet App</div>
                                <div class="text-muted small">iOS and Android readers synced</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background-color: rgba(255, 255, 255, 0.5);">
                            <div class="neumorphic-circle-sm">
                                <i class="bi bi-cloud-arrow-down"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="small fw-bold" style="color: #2d3436;">Offline Flipbooks</div>
                                <div class="text-muted small">Ultra-HD replica download</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background-color: rgba(255, 255, 255, 0.5);">
                            <div class="neumorphic-circle-sm">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="small fw-bold" style="color: #2d3436;">VIP Member Support</div>
                                <div class="text-muted small">Direct editorial concierge</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        // Neumorphic Soft Pink/Charcoal Reading Activity Bar Chart
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('subscriberReadingChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [
                            {
                                label: 'Reading Minutes',
                                data: [45, 65, 30, 85, 70, 110, 95],
                                backgroundColor: '#0ea5e9',
                                hoverBackgroundColor: '#0284c7',
                                borderRadius: 8,
                                borderSkipped: false,
                                barThickness: 28
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.parsed.y + ' minutes';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: '#636e72', font: { family: 'Inter' } }
                            },
                            y: {
                                grid: { color: 'rgba(163, 177, 198, 0.25)' },
                                ticks: {
                                    color: '#636e72',
                                    font: { family: 'Inter' },
                                    callback: function (val) { return val + 'm'; }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
