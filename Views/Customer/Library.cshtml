@model IEnumerable<Digital_Magzine.Models.MagazineIssue>

@{
    ViewData["Title"] = "My VIP Library";
    Layout = "_SubscriberLayout";
}

<div class="container-fluid px-0">
    <!-- Top Header & Metrics Summary -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700; font-size: 0.72rem;">
                    VIP ALL-ACCESS CATALOG
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #2d3436; letter-spacing: -0.5px;">My VIP Library</h1>
            <p class="text-muted small mb-0">Browse all digital magazine editions, back-issues, and special collector's releases included in your VIP Pass.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill px-3 py-2 fw-bold" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white;">
                @Model.Count() Unlocked Editions
            </span>
            <a href="/Customer/Dashboard" class="btn btn-neumorphic py-2 px-3 small">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="neumorphic-card p-5 text-center my-4">
            <div class="neumorphic-circle-sm mx-auto mb-3" style="color: #0ea5e9;">
                <i class="bi bi-journal-x fs-4"></i>
            </div>
            <h3 class="h5 fw-bold" style="color: #2d3436;">No Published Magazines Found</h3>
            <p class="text-muted small mb-0">Check back shortly as new editions are published to the digital newsstand.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var issue in Model)
            {
                var cover = !string.IsNullOrEmpty(issue.CoverImagePath)
                    ? issue.CoverImagePath
                    : (!string.IsNullOrEmpty(issue.CoverImageUrl) ? issue.CoverImageUrl : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80");
                var catName = issue.Category?.Name ?? issue.Magazine?.Category?.Name ?? "General";

                <div class="col">
                    <div class="neumorphic-card h-100 p-3 d-flex flex-column justify-content-between" style="border-radius: 18px;">
                        <div>
                            <!-- Cover Artwork -->
                            <div class="position-relative rounded-3 overflow-hidden mb-3 shadow-xs text-center" style="height: 260px; background: #dfe3ea;">
                                <img src="@cover" alt="@issue.Title" class="img-fluid rounded w-100 h-100" style="object-fit: cover;" />
                                <span class="badge position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill bg-white text-dark shadow-sm fw-bold small text-uppercase" style="font-size: 0.65rem;">
                                    @catName
                                </span>
                                <span class="badge position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill text-white shadow-sm fw-bold" style="background: rgba(14, 165, 233, 0.95); font-size: 0.68rem;">
                                    <i class="bi bi-award-fill me-1"></i> VIP Unlocked
                                </span>
                            </div>

                            <!-- Magazine Metadata -->
                            <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.7rem; color: #0284c7 !important;">
                                Vol. @issue.Volume &bull; @issue.PublishDate.ToString("MMMM yyyy")
                            </div>
                            <h2 class="h6 fw-bold mb-2 text-truncate" style="color: #2d3436;" title="@issue.Title">
                                @issue.Title
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(issue.Description))
                            {
                                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; font-size: 0.8rem;">
                                    @issue.Description
                                </p>
                            }
                        </div>

                        <!-- Solid Blue Read Now Button -->
                        <div class="pt-2 mt-auto" style="border-top: 1px solid rgba(0,0,0,0.06);">
                            <a href="/Reader/Issue/@issue.Id" class="btn btn-primary rounded-pill w-100 py-2 fw-bold text-center shadow-sm text-decoration-none" style="background-color: #0284c7; border-color: #0284c7;">
                                <i class="bi bi-book-half me-1"></i> Read Now &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
