@model IEnumerable<Digital_Magzine.Models.MagazineIssue>

@{
    ViewData["Title"] = "Magazines & Issues";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">

    <!-- Top Action Bar & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700; font-size: 0.72rem;">
                    CATALOG MANAGEMENT
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #2d3436; letter-spacing: -0.5px;">Categories &amp; Issues</h1>
            <p class="text-muted small mb-0">Organize and curate digital magazine editions, volumes, and thematic issues.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(14, 165, 233, 0.12); color: #0284c7;">
                Total Issues: @Model.Count()
            </span>
            <a asp-controller="MagazineIssues" asp-action="Create" class="btn btn-neumorphic-primary py-2 px-3 small">
                <i class="bi bi-plus-lg me-1"></i> + Create New Issue
            </a>
        </div>
    </div>

    <!-- Main Neumorphic Container with #e6e9f0 background and soft shadows -->
    <div class="neumorphic-card p-4 mb-4" style="background-color: #e6e9f0; border-radius: 20px; box-shadow: 9px 9px 16px rgba(163, 177, 198, 0.5), -9px -9px 16px rgba(255, 255, 255, 0.8);">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold" style="color: #2d3436;">Magazine Catalog</span>
                <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700;">@Model.Count() Editions</span>
            </div>
            <a asp-controller="MagazineIssues" asp-action="Create" class="small fw-bold text-decoration-none" style="color: #0ea5e9;">
                + Add New Issue &rarr;
            </a>
        </div>

        <div class="table-responsive">
            <table class="table neumorphic-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">Cover</th>
                        <th style="min-width: 220px;">Title &amp; Magazine</th>
                        <th>Volume Number</th>
                        <th>Release Date</th>
                        <th>PDF Reader</th>
                        <th>Status</th>
                        <th class="text-end" style="min-width: 190px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-album fs-2 d-block text-muted mb-2"></i>
                                <em>No magazine issues created yet. Click "+ Create New Issue" to start your first volume.</em>
                            </td>
                        </tr>
                    }
                    @foreach (var issue in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(issue.CoverImageUrl))
                                {
                                    <img src="@issue.CoverImageUrl" alt="@issue.Title Cover" class="rounded-3 object-fit-cover shadow-sm" style="width: 50px; height: 65px; border: 1px solid rgba(163, 177, 198, 0.3);" />
                                }
                                else
                                {
                                    <div class="rounded-3 d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 65px; background: rgba(163, 177, 198, 0.2); font-size: 0.75rem;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold fs-6 mb-0" style="color: #2d3436;">@issue.Title</div>
                                <div class="text-muted small">Issue ID: #@issue.Id</div>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-2 py-1" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; font-weight: 700;">
                                    Vol. @issue.Volume
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    @issue.PublishDate.ToString("MMMM dd, yyyy")
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(issue.PdfFilePath))
                                {
                                    <a asp-controller="Reader" asp-action="Issue" asp-route-id="@issue.Id" target="_blank" class="badge rounded-pill px-3 py-1 text-decoration-none" style="background: rgba(4, 120, 87, 0.12); color: #047857; font-weight: 700;">
                                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> Read PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(100, 116, 139, 0.15); color: #64748b;">
                                        No PDF
                                    </span>
                                }
                            </td>
                            <td>
                                @if (issue.IsPublished)
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(4, 120, 87, 0.12); color: #047857; font-weight: 700;">
                                        <i class="bi bi-check-circle me-1"></i> Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(245, 158, 11, 0.15); color: #b45309; font-weight: 700;">
                                        Draft
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    @if (!string.IsNullOrEmpty(issue.PdfFilePath))
                                    {
                                        <a asp-controller="Reader" asp-action="Issue" asp-route-id="@issue.Id" target="_blank" class="btn btn-neumorphic btn-sm py-1 px-2" title="Launch Immersive PDF Reader" style="color: #0284c7;">
                                            <i class="bi bi-book-half"></i>
                                        </a>
                                    }
                                    <a asp-controller="MagazineIssues" asp-action="Edit" asp-route-id="@issue.Id" class="btn btn-neumorphic btn-sm py-1 px-3 small">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                    <a asp-controller="MagazineIssues" asp-action="Details" asp-route-id="@issue.Id" class="btn btn-neumorphic btn-sm py-1 px-2 small">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="MagazineIssues" asp-action="Delete" asp-route-id="@issue.Id" class="btn btn-neumorphic btn-sm py-1 px-2 text-danger small">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
