@model Digital_Magzine.Models.SubscriptionPlan

@{
    ViewData["Title"] = "Delete Plan - " + Model.Name;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Subscription Plans</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h4 mb-0">Delete Confirmation</h2>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <h5 class="alert-heading fw-bold">Are you sure you want to delete this subscription plan?</h5>
                    <p class="mb-0">
                        Deleting this plan may affect users currently subscribed to it.
                    </p>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Plan Name</div>
                    <div class="col-sm-8 fw-bold">@Model.Name</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Price</div>
                    <div class="col-sm-8 text-success fw-bold">@SettingsService.GetCurrencySymbol()@Model.Price.ToString("0.00")</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Duration</div>
                    <div class="col-sm-8">@Model.DurationInMonths @(Model.DurationInMonths == 1 ? "Month" : "Months")</div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-4 text-muted">Existing Subscriptions</div>
                    <div class="col-sm-8">
                        <span class="badge bg-danger">@(Model.UserSubscriptions?.Count ?? 0) user subscriptions associated</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
