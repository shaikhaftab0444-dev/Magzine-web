@model Digital_Magzine.Models.SubscriptionPlan

@{
    ViewData["Title"] = "Plan Details - " + Model.Name;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Subscription Plans</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h4 mb-0">Subscription Plan Details</h2>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Edit Plan</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
            <div class="card-body p-4">
                <h3 class="h3 fw-bold">@Model.Name</h3>
                <div class="mb-4">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">Active Tier</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Inactive Tier</span>
                    }
                </div>

                <dl class="row">
                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8 fs-5 fw-bold text-success">@SettingsService.GetCurrencySymbol()@Model.Price.ToString("0.00")</dd>

                    <dt class="col-sm-4 text-muted">Duration</dt>
                    <dd class="col-sm-8">@Model.DurationInMonths @(Model.DurationInMonths == 1 ? "Month" : "Months")</dd>

                    <dt class="col-sm-4 text-muted">Total Subscriptions</dt>
                    <dd class="col-sm-8">@(Model.UserSubscriptions?.Count ?? 0) users subscribed</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
