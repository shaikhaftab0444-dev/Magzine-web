@model IEnumerable<Digital_Magzine.Models.MagazineIssue>

@{
    ViewData["Title"] = "Search Results - Culture Club";
    var query = ViewBag.Query as string ?? "";
}

<div class="container-fluid px-3 px-lg-5 py-5" style="min-height: calc(100vh - 200px);">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">
                @if (!string.IsNullOrWhiteSpace(query))
                {
                    <span>Search Results for <span class="text-primary">"@query"</span></span>
                }
                else
                {
                    <span>Explore Magazines</span>
                }
            </h1>
            <p class="text-muted small mb-0">
                Found @Model.Count() @(Model.Count() == 1 ? "issue" : "issues") matching your search criteria
            </p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 py-2 small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card p-5 text-center my-5 mx-auto" style="max-width: 650px;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 72px; height: 72px; background: rgba(14, 165, 233, 0.12); border: 1px solid rgba(14, 165, 233, 0.25);">
                <i class="bi bi-search fs-2 text-primary"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">No magazines found for '@query'</h3>
            <p class="text-muted mb-4">
                We couldn't find any magazine issues or articles matching your keyword. Try searching for a different title, topic, or category name.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    Browse All Magazines
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var issue in Model)
            {
                var cover = !string.IsNullOrEmpty(issue.CoverImagePath)
                    ? issue.CoverImagePath
                    : (!string.IsNullOrEmpty(issue.CoverImageUrl) ? issue.CoverImageUrl : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80");
                var catName = issue.Category?.Name ?? issue.Magazine?.Category?.Name ?? "General";
                var isFree = issue.SingleIssuePrice <= 0;

                <div class="col">
                    <div class="glass-card hover-3d p-3 h-100 d-flex flex-column" style="border-radius: 18px;">
                        <a asp-controller="Magazines" asp-action="Details" asp-route-id="@issue.Id" class="text-decoration-none text-dark d-block mb-3 position-relative overflow-hidden rounded-3 shadow-xs" style="aspect-ratio: 3/4; background: #f8fafc;">
                            <img src="@cover" alt="@issue.Title" class="w-100 h-100" style="object-fit: cover; transition: transform 0.4s ease;" />
                            <span class="badge position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill bg-white text-dark shadow-sm fw-bold small text-uppercase">
                                @catName
                            </span>
                            @if (isFree)
                            {
                                <span class="badge position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill bg-success text-white shadow-sm fw-bold small">
                                    FREE
                                </span>
                            }
                            else
                            {
                                <span class="badge position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill bg-dark text-white shadow-sm fw-bold small">
                                    @SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")
                                </span>
                            }
                        </a>

                        <div class="d-flex flex-column flex-grow-1">
                            <div class="text-muted small mb-1">
                                Vol. @issue.Volume &bull; @issue.PublishDate.ToString("MMM yyyy")
                            </div>
                            <h5 class="fw-bold text-dark mb-2 text-truncate" title="@issue.Title">
                                <a asp-controller="Magazines" asp-action="Details" asp-route-id="@issue.Id" class="text-decoration-none text-dark">
                                    @issue.Title
                                </a>
                            </h5>
                            @if (!string.IsNullOrWhiteSpace(issue.Description))
                            {
                                <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
                                    @issue.Description
                                </p>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }

                            <div class="pt-2 mt-auto border-top">
                                <a asp-controller="Magazines" asp-action="Details" asp-route-id="@issue.Id" class="btn btn-outline-dark btn-sm rounded-pill w-100 fw-semibold">
                                    View Details &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
