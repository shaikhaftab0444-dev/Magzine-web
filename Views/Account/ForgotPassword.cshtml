@{
    ViewData["Title"] = "Forgot Password - Culture Club";
}

<div class="auth-page-wrapper d-flex align-items-center justify-content-center py-5" style="min-height: calc(100vh - 120px); background: #eff6ff;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5">
                <div class="glass-card p-4 p-md-5" style="background: rgba(255, 255, 255, 0.65); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.1); color: #2d3436;">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 52px; height: 52px; background: rgba(14, 165, 233, 0.12); border: 1px solid rgba(14, 165, 233, 0.25);">
                            <i class="bi bi-key-fill fs-3 text-primary"></i>
                        </div>
                        <h2 class="h3 fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Reset Password</h2>
                        <p class="text-muted small mb-0">Enter your registered email address to receive password reset assistance.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-3">
                            <label class="form-label text-dark fw-semibold small">Registered Email Address</label>
                            <input type="email" name="email" class="form-control rounded-pill py-2 px-3 border" placeholder="name@example.com" style="background: rgba(255, 255, 255, 0.95); border-color: #cbd5e1;" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm mb-3">Send Reset Link</button>

                        <div class="text-center text-muted small">
                            Remember your credentials? <a asp-action="Login" class="text-primary fw-bold text-decoration-underline ms-1">Sign In</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
