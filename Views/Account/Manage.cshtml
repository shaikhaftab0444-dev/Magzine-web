@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Profile & Account Settings";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; font-weight: 700; font-size: 0.72rem;">
                ACCOUNT PREFERENCES
            </span>
        </div>
        <h1 class="h3 fw-bold mb-1" style="color: #2d3436; letter-spacing: -0.5px;">Profile &amp; Account Settings</h1>
        <p class="text-muted small mb-0">View registered credentials, account membership status, and manage profile security.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="neumorphic-card p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                    <div class="neumorphic-circle-sm" style="color: #0ea5e9; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold mb-0" style="color: #2d3436;">Account Information</h2>
                        <span class="text-muted small">Manage your personal account details.</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <div class="p-3 rounded-3" style="background: #e6e9f0; box-shadow: inset 2px 2px 5px #c8ccd6, inset -2px -2px 5px #ffffff; color: #2d3436; font-weight: 600;">
                            @Model.Email
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-muted">Username</label>
                        <div class="p-3 rounded-3" style="background: #e6e9f0; box-shadow: inset 2px 2px 5px #c8ccd6, inset -2px -2px 5px #ffffff; color: #2d3436; font-weight: 600;">
                            @Model.UserName
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Membership Tier</label>
                        <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background: #e6e9f0; box-shadow: inset 2px 2px 5px #c8ccd6, inset -2px -2px 5px #ffffff;">
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge rounded-pill px-3 py-1" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; font-weight: 700;">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Administrator
                                </span>
                            }
                            else if (User.IsInRole("Subscriber"))
                            {
                                <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; font-weight: 700;">
                                    <i class="bi bi-star-fill me-1"></i> VIP Subscriber
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-3 py-1" style="background: rgba(100, 116, 139, 0.15); color: #64748b; font-weight: 700;">
                                    Free Member
                                </span>
                            }
                            <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i> Active Status</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 pt-3" style="border-top: 1px solid rgba(0,0,0,0.06);">
                    <a asp-controller="MyAccount" asp-action="Index" class="btn btn-neumorphic-primary px-4 py-2">
                        <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                    </a>
                    <a href="/MyAccount/Index#library" class="btn btn-neumorphic px-4 py-2">
                        <i class="bi bi-journal-bookmark-fill me-1"></i> My Library
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            @if (!User.IsInRole("Admin") && !User.IsInRole("Subscriber"))
            {
                <div class="neumorphic-card p-4 mb-4 text-center" style="border: 2px solid rgba(14, 165, 233, 0.3);">
                    <div class="neumorphic-circle-sm mx-auto mb-3" style="color: #0ea5e9; width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-gem"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2" style="color: #2d3436;">Upgrade to VIP All-Access</h3>
                    <p class="text-muted small mb-4">Unlock the entire digital magazine catalog, unlimited PDF downloads, and subscriber-exclusive issues.</p>
                    <a asp-controller="SubscriptionPlans" asp-action="Index" class="btn btn-neumorphic-primary w-100 py-3 fw-bold">
                        View VIP Plans &rarr;
                    </a>
                </div>
            }

            <div class="neumorphic-card p-4">
                <h3 class="h6 fw-bold mb-3" style="color: #2d3436;">Security &amp; Session</h3>
                <p class="text-muted small mb-3">You are securely authenticated in this browser session.</p>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-neumorphic w-100 py-2 text-danger fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
