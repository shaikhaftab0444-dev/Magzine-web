@inject Digital_Magzine.Data.ApplicationDbContext _context
<!DOCTYPE html>
<html lang="en" id="top">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Culture Club</title>

    <!-- Google Fonts: Playfair Display (Serif) & Inter (Sans-serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Chart.js for Dashboards -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Editorial Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    bool isDashboard = ViewData["IsDashboard"] is true;
}
@if (isDashboard)
{
    @RenderBody()
}
else
{
    <!-- Top Header Navigation (Clean, White Zinio-Style with Responsive Bootstrap Collapse) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-xs py-2" style="z-index: 1040;">
        <div class="container-fluid px-3 px-lg-5">
            <!-- Left: Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center text-decoration-none me-3">
                <img src="@SettingsService.GetValue("LogoPath", "/images/system/logo.png")?v=@DateTime.Now.Ticks" 
                     alt="@SettingsService.GetValue("BrandName", "Culture Club")" 
                     class="rounded-circle me-2" style="width: 38px; height: 38px; object-fit: cover; aspect-ratio: 1/1;" 
                     onerror="this.style.display='none';" />
                <span class="fs-4" style="font-family: 'Inter', -apple-system, sans-serif; font-weight: 900; letter-spacing: -0.6px; color: #0f172a;">
                    @SettingsService.GetValue("BrandName", "Culture Club")
                </span>
            </a>

            <!-- Right Controls (Search + Profile) and Standard Navbar Toggler -->
            <div class="d-flex align-items-center gap-2 order-lg-3">
                <!-- Top Navbar Search Form -->
                <form asp-controller="Magazines" asp-action="Search" method="get" class="d-flex align-items-center d-none d-md-flex me-1">
                    <div class="input-group input-group-sm">
                        <input type="text" name="query" class="form-control rounded-pill-start border bg-light px-3" placeholder="Search magazines..." style="font-size: 0.85rem; width: 170px;" />
                        <button class="btn btn-outline-dark rounded-pill-end border px-3" type="submit" title="Search">
                            <i class="bi bi-search text-dark"></i>
                        </button>
                    </div>
                </form>

                <!-- Search Modal Trigger (Mobile) -->
                <button class="nav-icon-btn d-md-none" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" title="Search digital magazines">
                    <i class="bi bi-search fs-5 text-dark"></i>
                </button>

                <!-- Cart / Library Icon -->
                @if (User.IsInRole("Subscriber"))
                {
                    <a asp-controller="Customer" asp-action="Dashboard" class="nav-icon-btn position-relative" title="Subscriber Dashboard">
                        <i class="bi bi-journal-bookmark fs-5 text-dark"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="MyAccount" asp-action="Index" class="nav-icon-btn position-relative" title="My Library & Account">
                        <i class="bi bi-journal-bookmark fs-5 text-dark"></i>
                    </a>
                }

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 dropdown-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span class="d-none d-sm-inline">@User.Identity.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 py-2 mt-2" style="min-width: 220px;">
                            <li class="px-3 py-2 border-bottom">
                                <div class="small fw-bold text-truncate" style="max-width: 180px;">@User.Identity.Name</div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger mt-1">Administrator</span>
                                }
                                else if (User.IsInRole("Subscriber"))
                                {
                                    <span class="badge bg-success mt-1">Paid Subscriber</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary mt-1">Free Member</span>
                                }
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-danger"></i>Admin Console</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="MagazineIssues" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Magazine Issues</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="SubscriptionPlans" asp-action="Index"><i class="bi bi-tag me-2"></i>Subscription Plans</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-person me-2"></i>Admin Dashboard</a></li>
                            }
                            else if (User.IsInRole("Subscriber"))
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-journal-bookmark me-2 text-success"></i>Subscriber Dashboard</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item py-2" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-person me-2"></i>My Account</a></li>
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start rounded-pill">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-semibold">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold d-none d-sm-inline">
                        Join Free
                    </a>
                }

                <!-- Standard Bootstrap Navbar Toggler Button for Mobile Phones -->
                <button class="navbar-toggler border-0 shadow-none p-1 ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#storefrontNavbarNav" aria-controls="storefrontNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Center: Collapsible Navigation for MAGAZINES, EXPLORE, and MY LIBRARY -->
            <div class="collapse navbar-collapse order-lg-2" id="storefrontNavbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3 pt-3 pt-lg-0">
                    <!-- CATEGORIES Dynamic Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark text-uppercase letter-spacing-1 d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.88rem;">
                            CATEGORIES <i class="bi bi-chevron-down small text-muted" style="font-size: 0.7rem;"></i>
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg rounded-3 py-2 mt-2">
                            <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-fill me-2 text-primary"></i>All Titles</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            @foreach (var cat in _context.Categories.OrderBy(c => c.Name).ToList())
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/#cat-@cat.Id">
                                        <i class="bi bi-tag-fill me-2 text-primary small"></i>@cat.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>

                    <!-- MY LIBRARY Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark text-uppercase letter-spacing-1 d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.88rem;">
                            MY LIBRARY <i class="bi bi-chevron-down small text-muted" style="font-size: 0.7rem;"></i>
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg rounded-3 py-2 mt-2" style="min-width: 240px;">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                if (User.IsInRole("Subscriber"))
                                {
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>VIP Dashboard</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-clock-history me-2 text-secondary"></i>Reading History</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-bookmark-star me-2 text-secondary"></i>Saved Titles</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Purchased Issues</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-clock-history me-2 text-secondary"></i>Reading History</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-bookmark-star me-2 text-secondary"></i>Saved Titles</a></li>
                                }
                            }
                            else
                            {
                                <li class="px-3 py-2 text-muted small">Sign in to access your digital magazine shelf and reading history.</li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li><a class="dropdown-item py-2 fw-semibold text-primary" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Library</a></li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Offcanvas Navigation Drawer (Sidebar on click hamburger) -->
    <div class="offcanvas offcanvas-start offcanvas-editorial" tabindex="-1" id="cultureOffcanvas" aria-labelledby="cultureOffcanvasLabel">
        <div class="offcanvas-header border-bottom border-dark border-opacity-25 px-4 py-3">
            <div>
                <span class="logo-title text-white d-block fs-4">@SettingsService.GetValue("BrandName", "CULTURE CLUB")</span>
                <span class="logo-subtitle text-white-50 d-block">@SettingsService.GetValue("Tagline", "ALL THINGS THAT MATTER.")</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body px-4 py-4">
            <!-- Account / Role Section in Drawer -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="card bg-dark text-white border-secondary mb-4 p-3 rounded">
                    <div class="small text-white-50 mb-1">Signed in as</div>
                    <div class="fw-bold mb-2">@User.Identity.Name</div>
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger mb-3 align-self-start">Administrator</span>
                        <div class="d-flex flex-column gap-2">
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a>
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="MagazineIssues" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Magazine Issues</a>
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="Admin" asp-action="Articles"><i class="bi bi-newspaper me-2"></i>Manage Articles</a>
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="SubscriptionPlans" asp-action="Index"><i class="bi bi-tag me-2"></i>Subscription Plans</a>
                        </div>
                    }
                    else if (User.IsInRole("Subscriber"))
                    {
                        <span class="badge bg-success mb-3 align-self-start">Paid Subscriber</span>
                        <div class="d-flex flex-column gap-2">
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Subscriber Dashboard</a>
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-journal-bookmark me-2"></i>My VIP Library</a>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-3 align-self-start">Free Member</span>
                        <div class="d-flex flex-column gap-2">
                            <a class="btn btn-sm btn-warning text-dark text-start fw-semibold" asp-controller="SubscriptionPlans" asp-action="Index"><i class="bi bi-star me-2"></i>Upgrade to VIP All-Access</a>
                            <a class="btn btn-sm btn-outline-light text-start" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-journal-bookmark me-2"></i>My Library</a>
                        </div>
                    }
                    <hr class="border-secondary my-3" />
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex gap-2 mb-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light flex-grow-1">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light flex-grow-1">Register</a>
                </div>
            }

            <div class="text-uppercase text-white-50 small fw-bold letter-spacing-1 mb-3">Navigation</div>
            <ul class="list-unstyled d-flex flex-column gap-3 fs-5 serif-heading">
                <li><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">MAGAZINES</a></li>
                <li><a href="#" class="text-white text-decoration-none">EXPLORE</a></li>
                <li><a href="#" class="text-white text-decoration-none">MY LIBRARY</a></li>
            </ul>

            <hr class="border-secondary my-4" />

            <div class="text-uppercase text-white-50 small fw-bold letter-spacing-1 mb-3">Membership</div>
            <a href="#" class="btn btn-pill btn-pill-white w-100">
                Join the Club &rarr;
            </a>
        </div>
    </div>

    <!-- Main Render Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Top Newsletter Section (Light gray background) -->
    <section class="newsletter-section">
        <div class="container-fluid px-3 px-lg-5">
            <div class="row align-items-center g-4">
                <!-- Left: Title & Subtitle -->
                <div class="col-lg-5">
                    <h2 class="newsletter-title">Join the Culture Club</h2>
                    <p class="newsletter-subtitle">Get the latest stories, exclusive interviews and more — straight to your inbox.</p>
                </div>

                <!-- Center: Input field + Subscribe Button -->
                <div class="col-lg-5">
                    <form action="#" method="get" class="newsletter-form-container">
                        <input type="email" class="form-control input-pill" placeholder="Enter your email address" required />
                        <button type="submit" class="btn btn-pill btn-pill-dark px-4 flex-shrink-0">
                            Subscribe &rarr;
                        </button>
                    </form>
                </div>

                <!-- Right: Large CC Monogram Logo -->
                <div class="col-lg-2 newsletter-monogram d-none d-lg-block">
                    <div class="cc-monogram-text">CC</div>
                    <div class="cc-monogram-sub">@SettingsService.GetValue("BrandName", "CULTURE CLUB")</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Footer (Dark background #111) -->
    <footer class="culture-footer">
        <div class="container-fluid px-3 px-lg-5">
            <div class="row g-4 align-items-start">
                <!-- Col 1: Logo & Subtitle -->
                <div class="col-lg-3 col-md-6">
                    <div class="footer-logo-title">@SettingsService.GetValue("BrandName", "CULTURE CLUB")</div>
                    <div class="footer-logo-sub mb-3">@SettingsService.GetValue("Tagline", "ALL THINGS THAT MATTER.")</div>
                    <p class="text-muted small pe-lg-4">
                        An independent editorial journal covering style, art, contemporary technology, and culture worldwide.
                    </p>
                </div>

                <!-- Col 2: Categories (Dynamic Database Driven) -->
                <div class="col-lg-2 col-md-6 col-6">
                    <div class="footer-col-title">Categories</div>
                    <ul class="footer-links-list">
                        @foreach (var cat in _context.Categories.OrderBy(c => c.Name).ToList())
                        {
                            <li><a href="/#cat-@cat.Id">@cat.Name</a></li>
                        }
                    </ul>
                </div>

                <!-- Col 3: About -->
                <div class="col-lg-2 col-md-6 col-6">
                    <div class="footer-col-title">About</div>
                    <ul class="footer-links-list">
                        <li><a asp-controller="Support" asp-action="Index">Contact</a></li>
                        <li><a asp-controller="Legal" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Col 4: Follow Us (Social Icons) -->
                <div class="col-lg-2 col-md-6">
                    <div class="footer-col-title">Follow Us</div>
                    <div class="footer-social-icons">
                        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="Twitter X"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest"><i class="bi bi-pinterest"></i></a>
                    </div>
                </div>

                <!-- Far right: 3 square grayscale thumbnail images -->
                <div class="col-lg-3 col-md-12">
                    <div class="footer-thumbnails">
                        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=300&q=80" alt="Architecture" class="footer-thumb" />
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80" alt="Editorial Portrait" class="footer-thumb" />
                        <img src="https://images.unsplash.com/photo-1470723710355-95304d8aece4?auto=format&fit=crop&w=300&q=80" alt="Design Geometry" class="footer-thumb" />
                    </div>
                </div>
            </div>

            <!-- Bottom Row: Copyright, Policy Links, Back to top -->
            <div class="footer-bottom-bar d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    &copy; @DateTime.Now.Year Culture Club. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Legal" asp-action="Privacy">Privacy Policy</a>
                    <span class="text-secondary">|</span>
                    <a asp-controller="Legal" asp-action="Terms">Terms of Service</a>
                    <span class="text-secondary">|</span>
                    <a asp-controller="Legal" asp-action="Cookies">Cookie Preferences</a>
                </div>
                <div>
                    <a href="#top" class="text-decoration-none">Back to top &uarr;</a>
                </div>
            </div>
        </div>
    </footer>
}

    <!-- Search Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title serif-heading">Search Culture Club</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Magazines" asp-action="Search" method="get" class="d-flex">
                        <div class="input-group">
                            <input type="text" name="query" class="form-control rounded-pill-start py-2 px-3" placeholder="Search magazines, issues..." />
                            <button class="btn btn-dark rounded-pill-end px-4" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Dark Mode Toggle for Header and Dashboards
        const themeToggleBtns = document.querySelectorAll('#themeToggleBtn, .dashboard-theme-toggle');
        const themeIcons = document.querySelectorAll('#themeIcon, .dashboard-theme-icon');
        const currentTheme = localStorage.getItem('cultureClubTheme') || 'light';

        if (currentTheme === 'dark') {
            document.documentElement.setAttribute('data-bs-theme', 'dark');
            themeIcons.forEach(icon => {
                icon.classList.remove('bi-moon');
                icon.classList.add('bi-sun');
            });
        }

        themeToggleBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                const nextTheme = isDark ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', nextTheme);
                localStorage.setItem('cultureClubTheme', nextTheme);

                themeIcons.forEach(icon => {
                    icon.classList.toggle('bi-moon', isDark);
                    icon.classList.toggle('bi-sun', !isDark);
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
