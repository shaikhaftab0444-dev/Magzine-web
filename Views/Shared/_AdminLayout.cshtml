<!DOCTYPE html>
<html lang="en" id="top">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Culture Club Administration</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Neumorphic Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #e6e9f0; color: #2d3436; font-family: 'Inter', -apple-system, sans-serif;">
@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";

    var userEmail = User.Identity?.Name ?? "Member";
    var userDisplayName = userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail;
    var userInitials = userDisplayName.Length >= 2 ? userDisplayName.Substring(0, 2).ToUpper() : (userDisplayName.Length == 1 ? userDisplayName.ToUpper() : "U");
    var userRoleTitle = User.IsInRole("Admin") ? "Administrator" : (User.IsInRole("Subscriber") ? "VIP Subscriber" : "Free Member");

    string brandController = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("Subscriber") ? "Customer" : "MyAccount");
    string brandAction = User.IsInRole("Admin") ? "Index" : (User.IsInRole("Subscriber") ? "Dashboard" : "Index");
    string brandSubtitle = User.IsInRole("Admin") ? "ADMINISTRATION" : (User.IsInRole("Subscriber") ? "VIP SUBSCRIBER" : "MEMBER DASHBOARD");
}

<div class="cc-dashboard-wrapper neumorphic-theme">
    <!-- Left-Side Neumorphic Sidebar Navigation (Offcanvas on Mobile, Fixed on Desktop) -->
    <aside class="offcanvas offcanvas-start cc-sidebar cc-sidebar-neumorphic" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
        <div class="d-flex flex-column h-100 justify-content-between">
            <div>
                <!-- Top Header inside Sidebar: Logo + Mobile Close Button -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <a asp-controller="@brandController" asp-action="@brandAction" class="cc-sidebar-brand text-decoration-none m-0 d-flex align-items-center">
                        <img src="@SettingsService.GetValue("LogoPath", "/images/system/logo.png")?v=@DateTime.Now.Ticks" 
                             alt="@SettingsService.GetValue("BrandName", "Culture Club")" 
                             class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover; aspect-ratio: 1/1;" 
                             onerror="this.style.display='none'; document.getElementById('adminMonogramFallback').style.display='flex';" />
                        <span id="adminMonogramFallback" class="cc-monogram-sky" style="display: none;">CC</span>
                        <div>
                            <span class="cc-brand-title d-block" style="color: #2d3436; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.5px;">@SettingsService.GetValue("BrandName", "CULTURE CLUB")</span>
                            <span class="cc-brand-subtitle d-block" style="color: #0ea5e9; font-weight: 700; font-size: 0.65rem;">@brandSubtitle</span>
                        </div>
                    </a>
                    <button type="button" class="btn-close d-md-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
                </div>

                <!-- Sidebar Navigation: Dynamic Role-Based Links -->
                <ul class="cc-nav-list">
                    @if (User.IsInRole("Admin"))
                    {
                        <!-- Admin Navigation Links -->
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="Index" class="cc-nav-link @(currentController == "Admin" && (currentAction is "Index" or "Dashboard") ? "active" : "")">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="MagazineIssues" asp-action="Index" class="cc-nav-link @(currentController == "MagazineIssues" || (currentController == "Admin" && currentAction == "Issues") ? "active" : "")">
                                <i class="bi bi-journal-album"></i>
                                <span>Magazines &amp; Issues</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Categories" asp-action="Index" class="cc-nav-link @(currentController == "Categories" ? "active" : "")">
                                <i class="bi bi-tags"></i>
                                <span>Categories</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="Subscribers" class="cc-nav-link @(currentController == "Admin" && currentAction == "Subscribers" ? "active" : "")">
                                <i class="bi bi-people"></i>
                                <span>Subscribers</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="PaymentRequests" class="cc-nav-link @(currentController == "Admin" && currentAction == "PaymentRequests" ? "active" : "")">
                                <i class="bi bi-qr-code-scan"></i>
                                <span>Payment Requests</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="UploadQR" class="cc-nav-link @(currentController == "Admin" && currentAction == "UploadQR" ? "active" : "")">
                                <i class="bi bi-qr-code"></i>
                                <span>Upload QR</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="Analytics" class="cc-nav-link @(currentController == "Admin" && currentAction == "Analytics" ? "active" : "")">
                                <i class="bi bi-bar-chart-line"></i>
                                <span>Analytics</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="Users" class="cc-nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")">
                                <i class="bi bi-person"></i>
                                <span>Users</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="Settings" class="cc-nav-link @(currentController == "Admin" && currentAction == "Settings" ? "active" : "")">
                                <i class="bi bi-gear"></i>
                                <span>Settings</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Admin" asp-action="SupportTickets" class="cc-nav-link @(currentController == "Admin" && currentAction == "SupportTickets" ? "active" : "")">
                                <i class="bi bi-headset"></i>
                                <span>Support Tickets</span>
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Subscriber"))
                    {
                        <!-- VIP Subscriber Navigation Links -->
                        <li class="cc-nav-item">
                            <a href="/Customer/Dashboard" class="cc-nav-link @(currentController == "Customer" && (currentAction is "Index" or "Dashboard") ? "active" : "")">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a href="/Customer/Library" class="cc-nav-link @(currentController == "Customer" && currentAction == "Library" ? "active" : "")">
                                <i class="bi bi-journal-bookmark-fill"></i>
                                <span>My Library</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a href="/Customer/History" class="cc-nav-link @(currentController == "Customer" && currentAction == "History" ? "active" : "")">
                                <i class="bi bi-clock-history"></i>
                                <span>History</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a href="/Account/Manage" class="cc-nav-link @(currentController == "Account" ? "active" : "")">
                                <i class="bi bi-person-gear"></i>
                                <span>My Account</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Support" asp-action="Index" class="cc-nav-link @(currentController == "Support" ? "active" : "")">
                                <i class="bi bi-headset"></i>
                                <span>Customer Support</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- Free User Navigation Links -->
                        <li class="cc-nav-item">
                            <a asp-controller="MyAccount" asp-action="Index" class="cc-nav-link @(currentController == "MyAccount" && currentAction == "Index" ? "active" : "")">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a href="/MyAccount/Index#library" class="cc-nav-link">
                                <i class="bi bi-journal-bookmark-fill"></i>
                                <span>My Library</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="MyAccount" asp-action="History" class="cc-nav-link @(currentController == "MyAccount" && currentAction == "History" ? "active" : "")">
                                <i class="bi bi-clock-history"></i>
                                <span>Reading History</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="SubscriptionPlans" asp-action="Index" class="cc-nav-link @(currentController == "SubscriptionPlans" ? "active" : "")" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(2, 132, 199, 0.25)); border: 1px solid rgba(14, 165, 233, 0.4); color: #0284c7; font-weight: 700; border-radius: 12px; margin-top: 6px; margin-bottom: 6px;">
                                <i class="bi bi-gem" style="color: #0ea5e9;"></i>
                                <span>Upgrade to VIP</span>
                                <span class="badge rounded-pill ms-auto" style="background: #0ea5e9; color: white; font-size: 0.65rem;">NEW</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Account" asp-action="Manage" class="cc-nav-link @(currentController == "Account" && currentAction == "Manage" ? "active" : "")">
                                <i class="bi bi-person-gear"></i>
                                <span>Profile Settings</span>
                            </a>
                        </li>
                        <li class="cc-nav-item">
                            <a asp-controller="Support" asp-action="Index" class="cc-nav-link @(currentController == "Support" ? "active" : "")">
                                <i class="bi bi-headset"></i>
                                <span>Customer Support</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Sidebar Bottom: Status & Utilities -->
            <div class="cc-sidebar-bottom">
                <div class="d-flex gap-2 mb-2">
                    <a href="/" class="btn btn-neumorphic flex-grow-1 small py-2" title="Storefront">
                        <i class="bi bi-shop me-1"></i> Storefront
                    </a>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                    <button type="submit" class="btn btn-neumorphic w-100 text-danger small py-2">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content Area (100% Width on Mobile) -->
    <main class="cc-dashboard-content">
        <!-- Persistent Top Header -->
        <div class="dashboard-header mb-4">
            <div class="d-flex align-items-center flex-grow-1">
                <!-- Hamburger Menu Button (Visible on screens < 768px) -->
                <button class="btn btn-neumorphic d-md-none me-3 py-2 px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Toggle Navigation Menu">
                    <i class="bi bi-list fs-5" style="color: #0ea5e9;"></i>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Notifications" asp-action="Index" class="neumorphic-circle-btn position-relative text-decoration-none d-flex align-items-center justify-content-center" aria-label="Notifications" title="Notifications">
                    <i class="bi bi-bell" style="color: #2d3436;"></i>
                    <span class="notification-badge-dot" style="background-color: #0ea5e9; border-color: #e6e9f0;"></span>
                </a>

                <div class="dropdown">
                    <button class="btn btn-neumorphic d-flex align-items-center gap-2 px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 50px !important;">
                        <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem; background: var(--neu-sky-gradient);">
                            @userInitials
                        </div>
                        <div class="text-start d-none d-sm-block">
                            <div class="small fw-bold lh-1" style="color: #2d3436;">@userDisplayName</div>
                            <div class="text-muted" style="font-size: 0.7rem;">@userRoleTitle</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted small ms-1"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" style="background-color: #ffffff; min-width: 210px;">
                        <li><h6 class="dropdown-header small fw-bold text-uppercase" style="color: #0ea5e9;">@userRoleTitle</h6></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a class="dropdown-item py-2 fw-semibold" asp-controller="MagazineIssues" asp-action="Create"><i class="bi bi-plus-circle me-2 text-primary"></i>+ Add Magazine</a></li>
                            <li><a class="dropdown-item py-2 fw-semibold" asp-controller="SubscriptionPlans" asp-action="Create"><i class="bi bi-credit-card me-2 text-success"></i>New Plan</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="PaymentRequests"><i class="bi bi-qr-code-scan me-2 text-warning"></i>Payment Requests</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="UploadQR"><i class="bi bi-qr-code me-2 text-info"></i>Upload QR</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="SupportTickets"><i class="bi bi-headset me-2 text-danger"></i>Support Tickets</a></li>
                        }
                        else if (User.IsInRole("Subscriber"))
                        {
                            <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-primary"></i>VIP Dashboard</a></li>
                            <li><a class="dropdown-item py-2" href="/MyAccount/Index#library"><i class="bi bi-journal-bookmark-fill me-2 text-success"></i>My Library</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="MyAccount" asp-action="History"><i class="bi bi-clock-history me-2 text-info"></i>Reading History</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Manage"><i class="bi bi-person-gear me-2"></i>Account Settings</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Support" asp-action="Index"><i class="bi bi-headset me-2 text-primary"></i>Customer Support</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item py-2 fw-semibold" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</a></li>
                            <li><a class="dropdown-item py-2" href="/MyAccount/Index#library"><i class="bi bi-journal-bookmark-fill me-2 text-success"></i>My Library</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="MyAccount" asp-action="History"><i class="bi bi-clock-history me-2 text-info"></i>Reading History</a></li>
                            <li><a class="dropdown-item py-2 fw-bold text-primary" asp-controller="SubscriptionPlans" asp-action="Index"><i class="bi bi-gem me-2"></i>Upgrade to VIP</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Manage"><i class="bi bi-person-gear me-2"></i>Profile Settings</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Support" asp-action="Index"><i class="bi bi-headset me-2 text-primary"></i>Customer Support</a></li>
                        }
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 pt-1">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start rounded-pill">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Global Flash Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 neumorphic-card text-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 neumorphic-card text-danger mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Page Specific Body Content -->
        @RenderBody()
    </main>
</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
