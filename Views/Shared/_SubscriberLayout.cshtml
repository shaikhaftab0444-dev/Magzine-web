@inject Digital_Magzine.Services.ISettingsService SettingsService
<!DOCTYPE html>
<html lang="en" id="top">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SettingsService.GetValue("BrandName", "Culture Club")</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Neumorphic Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #e6e9f0; color: #2d3436; font-family: 'Inter', -apple-system, sans-serif;">
@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Customer";

    var userEmail = User.Identity?.Name ?? "Subscriber";
    var userDisplayName = userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail;
    var userInitials = userDisplayName.Length >= 2 ? userDisplayName.Substring(0, 2).ToUpper() : (userDisplayName.Length == 1 ? userDisplayName.ToUpper() : "U");
}

<div class="cc-dashboard-wrapper neumorphic-theme">
    <!-- Left-Side Neumorphic Sidebar Navigation -->
    <aside class="cc-sidebar cc-sidebar-neumorphic">
        <div class="d-flex flex-column h-100 justify-content-between">
            <div>
                <!-- Top Header inside Sidebar: Dynamic Logo & Brand Name -->
                <a href="/Customer/Dashboard" class="cc-sidebar-brand text-decoration-none d-flex align-items-center mb-4">
                    <img src="@SettingsService.GetValue("LogoPath")" 
                         class="rounded-circle me-2" 
                         style="width: 35px; height: 35px; object-fit: cover; aspect-ratio: 1/1;" 
                         alt="Logo" 
                         onerror="this.style.display='none'; document.getElementById('subMonogramFallback').style.display='flex';" />
                    <span id="subMonogramFallback" class="cc-monogram-pink me-2" style="display: none;">CC</span>
                    <div>
                        <span class="cc-brand-title d-block" style="color: #2d3436; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.5px;">@SettingsService.GetValue("BrandName")</span>
                        <span class="cc-brand-subtitle d-block" style="color: #0ea5e9; font-weight: 700; font-size: 0.65rem;">SUBSCRIBER VIP</span>
                    </div>
                </a>

                <!-- Sidebar Navigation: Neumorphic Links -->
                <ul class="cc-nav-list">
                    <li class="cc-nav-item">
                        <a href="/Customer/Dashboard" class="cc-nav-link @(currentController == "Customer" && (currentAction is "Dashboard" or "Index") ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="cc-nav-item">
                        <a href="/Customer/Library" class="cc-nav-link @(currentController == "Customer" && currentAction == "Library" ? "active" : "")">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <span>My Library</span>
                        </a>
                    </li>
                    <li class="cc-nav-item">
                        <a href="/Customer/History" class="cc-nav-link @(currentController == "Customer" && currentAction == "History" ? "active" : "")">
                            <i class="bi bi-clock-history"></i>
                            <span>History</span>
                        </a>
                    </li>
                    <li class="cc-nav-item">
                        <a href="/Account/Manage" class="cc-nav-link @(currentController == "Account" ? "active" : "")">
                            <i class="bi bi-person-gear"></i>
                            <span>My Account</span>
                        </a>
                    </li>
                    <li class="cc-nav-item">
                        <a asp-controller="Support" asp-action="Index" class="cc-nav-link @(currentController == "Support" ? "active" : "")">
                            <i class="bi bi-headset"></i>
                            <span>Customer Support</span>
                        </a>
                    </li>
                    <li class="cc-nav-item">
                        <a href="/" class="cc-nav-link">
                            <i class="bi bi-shop"></i>
                            <span>Storefront</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Bottom: Status & Utilities -->
            <div class="cc-sidebar-bottom">
                <div class="neumorphic-card p-3 mb-2" style="border-radius: 14px !important;">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="badge rounded-pill" style="background: var(--neu-pink-gradient); color: white; font-weight: 700; font-size: 0.7rem;">
                            <i class="bi bi-award-fill me-1"></i> VIP PASS
                        </span>
                        <span class="small fw-bold text-success" style="font-size: 0.75rem;">Active</span>
                    </div>
                    <div class="small text-muted" style="font-size: 0.72rem;">Unlimited All-Access</div>
                </div>

                <div class="d-flex gap-2 mb-2">
                    <a href="/" class="btn btn-neumorphic flex-grow-1 small py-2" title="Storefront">
                        <i class="bi bi-shop me-1"></i> Storefront
                    </a>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                    <button type="submit" class="btn btn-neumorphic w-100 text-danger small py-2">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="cc-dashboard-content">
        <!-- Persistent Top Header -->
        <div class="dashboard-header mb-4">
            <div class="dashboard-search-box flex-grow-1 me-3">
                <form asp-controller="Magazines" asp-action="Search" method="get" class="d-flex align-items-center w-100">
                    <i class="bi bi-search text-muted me-2"></i>
                    <input type="text" name="query" class="form-control dashboard-search-input neumorphic-input border-0 bg-transparent p-0" placeholder="Search digital issues, magazines, topics..." />
                </form>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Notifications" asp-action="Index" class="neumorphic-circle-btn position-relative text-decoration-none d-flex align-items-center justify-content-center" aria-label="Notifications" title="Notifications">
                    <i class="bi bi-bell" style="color: #2d3436;"></i>
                    <span class="notification-badge-dot" style="background-color: #0ea5e9; border-color: #e6e9f0;"></span>
                </a>

                <div class="dropdown">
                    <button class="btn btn-neumorphic d-flex align-items-center gap-2 px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 50px !important;">
                        <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem; background: var(--neu-sky-gradient);">
                            @userInitials
                        </div>
                        <div class="text-start d-none d-sm-block">
                            <div class="small fw-bold lh-1" style="color: #2d3436;">@userDisplayName</div>
                            <div class="text-muted" style="font-size: 0.7rem; color: #0ea5e9 !important;">VIP Subscriber</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted small ms-1"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" style="background-color: #ffffff; min-width: 210px;">
                        <li><h6 class="dropdown-header small fw-bold text-uppercase" style="color: #0ea5e9;">VIP Account</h6></li>
                        <li><a class="dropdown-item py-2 fw-semibold" href="/Customer/Dashboard"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" href="/Customer/Library"><i class="bi bi-journal-bookmark-fill me-2 text-success"></i>My Library</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" href="/Customer/History"><i class="bi bi-clock-history me-2 text-info"></i>History</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" href="/Account/Manage"><i class="bi bi-person-gear me-2"></i>My Account</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 pt-1">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start rounded-pill">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        @RenderBody()
    </main>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
