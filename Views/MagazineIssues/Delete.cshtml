@model Digital_Magzine.Models.MagazineIssue

@{
    ViewData["Title"] = "Delete Issue - " + Model.Title;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Magazine Issues</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h4 mb-0">Delete Confirmation</h2>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <h5 class="alert-heading fw-bold">Are you sure you want to delete this issue?</h5>
                    <p class="mb-0">
                        Deleting this magazine issue will also delete all associated articles due to cascade delete rules. This action cannot be undone.
                    </p>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted">Title</div>
                    <div class="col-sm-9 fw-bold">@Model.Title</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted">Volume</div>
                    <div class="col-sm-9">Volume @Model.Volume</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted">Publish Date</div>
                    <div class="col-sm-9">@Model.PublishDate.ToString("MMMM dd, yyyy")</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted">Status</div>
                    <div class="col-sm-9">
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-3 text-muted">Associated Articles</div>
                    <div class="col-sm-9">
                        <span class="badge bg-danger">@(Model.Articles?.Count ?? 0) articles will be deleted</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
