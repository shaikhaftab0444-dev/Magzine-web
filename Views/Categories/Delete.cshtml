@model Digital_Magzine.Models.Category

@{
    ViewData["Title"] = "Delete Category - " + Model.Name;
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-neumorphic btn-sm py-2 px-3 small">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="neumorphic-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="neumorphic-circle-sm" style="color: #ef4444;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold mb-0" style="color: #2d3436;">Delete Category</h2>
                    <span class="text-danger small fw-semibold">Are you sure you want to permanently delete this category?</span>
                </div>
            </div>

            <div class="p-3 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.55); border: 1px solid rgba(163, 177, 198, 0.25);">
                <div class="mb-2">
                    <span class="text-muted small">Category Name:</span>
                    <div class="fw-bold fs-5" style="color: #2d3436;">@Model.Name</div>
                </div>
                <div>
                    <span class="text-muted small">Description:</span>
                    <div class="small" style="color: #2d3436;">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-neumorphic px-4 py-2 small">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
