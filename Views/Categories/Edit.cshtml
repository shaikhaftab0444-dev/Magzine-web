@model Digital_Magzine.Models.Category

@{
    ViewData["Title"] = "Edit Category - " + Model.Name;
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-neumorphic btn-sm py-2 px-3 small">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="neumorphic-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="neumorphic-circle-sm" style="color: #0ea5e9;">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold mb-0" style="color: #2d3436;">Edit Category</h2>
                    <span class="text-muted small">Update category name and editorial description</span>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 neumorphic-card small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold" style="color: #2d3436;">Category Name</label>
                    <input asp-for="Name" class="form-control neumorphic-input w-100" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-bold" style="color: #2d3436;">Description</label>
                    <textarea asp-for="Description" class="form-control neumorphic-input w-100" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-neumorphic px-4 py-2 small">Cancel</a>
                    <button type="submit" class="btn btn-neumorphic-primary px-4 py-2 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
