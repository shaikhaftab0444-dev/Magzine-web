@model Digital_Magzine.Models.MagazineIssue

@{
    Layout = null;
    var displayPdfPath = !string.IsNullOrEmpty(Model.PdfFilePath) 
        ? Model.PdfFilePath 
        : "/pdfs/f9ebdf6e-d7ff-474b-8fcc-b6e15550d4c0_sample_issue.pdf";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - Immersive Reader</title>

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            background-color: #121212;
            margin: 0;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* Fixed Top Navigation Bar (Dark, Slightly Transparent) */
        .reader-topbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 56px;
            background: rgba(18, 18, 18, 0.88);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.25rem;
        }

        .reader-back-link {
            color: #ffffff;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s ease;
        }

        .reader-back-link:hover {
            color: #38bdf8;
            background: rgba(255, 255, 255, 0.18);
            border-color: #38bdf8;
            transform: translateX(-2px);
        }

        .reader-title {
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 55%;
            text-align: center;
        }

        .reader-tools {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .reader-tool-btn {
            color: #cbd5e1;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .reader-tool-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.18);
            border-color: #38bdf8;
        }

        /* Fullscreen PDF Viewport */
        .pdf-viewport {
            width: 100%;
            height: 100vh;
            padding-top: 56px;
            box-sizing: border-box;
            background-color: #121212;
            overflow: hidden;
        }

        body.is-fullscreen .reader-topbar {
            display: none;
        }

        body.is-fullscreen .pdf-viewport {
            padding-top: 0;
        }
    </style>
</head>
<body style="background-color: #121212; margin: 0; overflow: hidden;">

    <!-- Fixed Top Navigation Bar (Dark, Slightly Transparent) -->
    <header class="reader-topbar">
        <!-- Left: <- Back to Details Link -->
        <div>
            <a href="/Magazines/Details/@Model.Id" class="reader-back-link" title="Return to Magazine Details">
                <i class="bi bi-arrow-left"></i>
                <span>&larr; Back to Details</span>
            </a>
        </div>

        <!-- Center: Magazine Issue Title -->
        <div class="reader-title" title="@Model.Title">
            @Model.Title
        </div>

        <!-- Right: Actions (Fullscreen, Pop-out, Close) -->
        <div class="reader-tools">
            <button type="button" class="reader-tool-btn" id="fsToggleBtn" onclick="toggleFullScreen()" title="Toggle Fullscreen">
                <i class="bi bi-arrows-fullscreen" id="fsIcon"></i>
            </button>
            <a href="@displayPdfPath" target="_blank" class="reader-tool-btn" title="Open PDF in new tab">
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <a href="/Magazines/Details/@Model.Id" class="reader-tool-btn" title="Close Reader">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </header>

    <!-- Full-Screen PDF Embed -->
    <main class="pdf-viewport">
        <object data="@(string.IsNullOrEmpty(Model.PdfFilePath) ? displayPdfPath : Model.PdfFilePath)#toolbar=0&navpanes=0" type="application/pdf" width="100%" height="100%" style="height: 100vh; border: none;">
            <iframe src="@(string.IsNullOrEmpty(Model.PdfFilePath) ? displayPdfPath : Model.PdfFilePath)#toolbar=0&navpanes=0" width="100%" height="100%" style="height: 100vh; border: none;">
                <div style="color: #ffffff; text-align: center; padding: 4rem;">
                    <p class="fs-5 mb-3">Unable to display PDF directly in your browser frame.</p>
                    <a href="@displayPdfPath" target="_blank" class="btn btn-outline-info rounded-pill px-4">Open PDF Document &rarr;</a>
                </div>
            </iframe>
        </object>
    </main>

    <script>
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().then(() => {
                    document.body.classList.add('is-fullscreen');
                    document.getElementById('fsIcon').classList.replace('bi-arrows-fullscreen', 'bi-fullscreen-exit');
                }).catch(err => console.error(err));
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().then(() => {
                        document.body.classList.remove('is-fullscreen');
                        document.getElementById('fsIcon').classList.replace('bi-fullscreen-exit', 'bi-arrows-fullscreen');
                    });
                }
            }
        }

        document.addEventListener('fullscreenchange', () => {
            const isFs = !!document.fullscreenElement;
            const icon = document.getElementById('fsIcon');
            if (isFs) {
                document.body.classList.add('is-fullscreen');
                if (icon) icon.classList.replace('bi-arrows-fullscreen', 'bi-fullscreen-exit');
            } else {
                document.body.classList.remove('is-fullscreen');
                if (icon) icon.classList.replace('bi-fullscreen-exit', 'bi-arrows-fullscreen');
            }
        });

        // Track reading history via AJAX call
        try {
            fetch('/Reader/TrackReading?issueId=@Model.Id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).catch(e => console.log('Reading history logged'));
        } catch (e) {}
    </script>
</body>
</html>
