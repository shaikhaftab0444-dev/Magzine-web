@model Digital_Magzine.Models.MagazineIssue

@{
    Layout = null;
    var displayPdfPath = !string.IsNullOrEmpty(Model.PdfFilePath) 
        ? Model.PdfFilePath 
        : "/pdfs/f9ebdf6e-d7ff-474b-8fcc-b6e15550d4c0_sample_issue.pdf";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - Immersive Reader</title>

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- PDF.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* Anti-Theft: Disable Text/Canvas Selection Globally */
        body {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            background-color: #121212;
            margin: 0;
            overflow-x: hidden;
            overflow-y: auto;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* Fixed Top Navigation Bar (Dark, Slightly Transparent) */
        .reader-topbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 56px;
            background: rgba(18, 18, 18, 0.92);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.25rem;
        }

        .reader-back-link {
            color: #ffffff;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s ease;
        }

        .reader-back-link:hover {
            color: #38bdf8;
            background: rgba(255, 255, 255, 0.18);
            border-color: #38bdf8;
            transform: translateX(-2px);
        }

        .reader-title {
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 55%;
            text-align: center;
        }

        .reader-tools {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .reader-tool-btn {
            color: #cbd5e1;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .reader-tool-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.18);
            border-color: #38bdf8;
        }

        /* Centered PDF Viewer Viewport */
        .pdf-viewport {
            min-height: 100vh;
            padding-top: 76px;
            padding-bottom: 96px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background-color: #121212;
            overflow-y: auto;
            overflow-x: auto;
        }

        #pdf-render {
            display: block;
            margin: 0 auto;
            max-width: 95vw;
            height: auto;
            background: #ffffff;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            border-radius: 4px;
            pointer-events: none; /* Prevents dragging canvas image */
        }

        /* Neumorphic Reader Navigation Pill */
        .neumorphic-reader-nav {
            background: rgba(24, 28, 36, 0.95);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 1px 1px 1px rgba(255, 255, 255, 0.08);
            pointer-events: auto;
        }

        .neumorphic-reader-btn {
            background: #1e2430;
            color: #e2e8f0;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.4), -1px -1px 3px rgba(255, 255, 255, 0.06);
            transition: all 0.18s ease;
        }

        .neumorphic-reader-btn:hover:not(:disabled) {
            background: #283142;
            color: #38bdf8;
            border-color: #38bdf8;
            box-shadow: inset 1px 1px 2px rgba(0, 0, 0, 0.3);
            transform: translateY(-1px);
        }

        .neumorphic-reader-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
            border-color: rgba(255, 255, 255, 0.05);
        }

        .neumorphic-reader-icon-btn {
            background: #1e2430;
            color: #cbd5e1;
            border: 1px solid rgba(255, 255, 255, 0.12);
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.4), -1px -1px 3px rgba(255, 255, 255, 0.06);
            transition: all 0.18s ease;
        }

        .neumorphic-reader-icon-btn:hover {
            color: #38bdf8;
            border-color: #38bdf8;
        }

        body.is-fullscreen .reader-topbar {
            display: none;
        }

        body.is-fullscreen .pdf-viewport {
            padding-top: 20px;
        }
    </style>
</head>
<body oncontextmenu="return false;">

    <!-- Fixed Top Navigation Bar -->
    <header class="reader-topbar">
        <!-- Left: <- Back to Details Link -->
        <div>
            <a href="/Magazines/Details/@Model.Id" class="reader-back-link" title="Return to Magazine Details">
                <i class="bi bi-arrow-left"></i>
                <span>&larr; Back to Details</span>
            </a>
        </div>

        <!-- Center: Magazine Issue Title -->
        <div class="reader-title" title="@Model.Title">
            @Model.Title
        </div>

        <!-- Right: Actions (Fullscreen, Close) -->
        <div class="reader-tools">
            <button type="button" class="reader-tool-btn" id="fsToggleBtn" onclick="toggleFullScreen()" title="Toggle Fullscreen">
                <i class="bi bi-arrows-fullscreen" id="fsIcon"></i>
            </button>
            <a href="/Magazines/Details/@Model.Id" class="reader-tool-btn" title="Close Reader">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </header>

    <!-- Secure HTML5 Canvas PDF Viewport -->
    <main class="pdf-viewport">
        <div class="position-relative text-center">
            <!-- PDF Canvas: Text rendered as flat pixels, preventing text highlight and copy -->
            <canvas id="pdf-render" class="shadow-lg"></canvas>

            <div id="loading-spinner" class="position-absolute top-50 start-50 translate-middle text-center" style="display: none;">
                <div class="spinner-border text-info" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                <div class="text-light small mt-2 fw-semibold">Rendering Page...</div>
            </div>
        </div>
    </main>

    <!-- Fixed Bottom Neumorphic Navigation Controls -->
    <div class="fixed-bottom d-flex align-items-center justify-content-center p-3" style="pointer-events: none; z-index: 1060;">
        <div class="d-flex align-items-center gap-3 px-4 py-2 rounded-pill neumorphic-reader-nav">
            <button id="prev-page" class="btn btn-sm neumorphic-reader-btn rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1" title="Previous Page">
                <i class="bi bi-chevron-left"></i>
                <span>Prev Page</span>
            </button>

            <div class="text-light small fw-bold px-2 text-nowrap">
                Page <span id="page-num" class="text-info fw-bold">1</span> of <span id="page-count" class="text-muted">-</span>
            </div>

            <button id="next-page" class="btn btn-sm neumorphic-reader-btn rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1" title="Next Page">
                <span>Next Page</span>
                <i class="bi bi-chevron-right"></i>
            </button>

            <div class="vr bg-secondary opacity-50 mx-1" style="height: 18px;"></div>

            <button id="zoom-out" class="neumorphic-reader-icon-btn" title="Zoom Out">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button id="zoom-in" class="neumorphic-reader-icon-btn" title="Zoom In">
                <i class="bi bi-zoom-in"></i>
            </button>
        </div>
    </div>

    <!-- Secure PDF.js Rendering Script & Anti-Theft Listeners -->
    <script>
        // Configure PDF.js Worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

        const pdfUrl = '@(string.IsNullOrEmpty(Model.PdfFilePath) ? displayPdfPath : Model.PdfFilePath)';
        let pdfDoc = null,
            pageNum = 1,
            pageRendering = false,
            pageNumPending = null,
            scale = 1.35,
            canvas = document.getElementById('pdf-render'),
            ctx = canvas.getContext('2d'),
            spinner = document.getElementById('loading-spinner');

        function renderPage(num) {
            pageRendering = true;
            if (spinner) spinner.style.display = 'block';

            pdfDoc.getPage(num).then(function(page) {
                const viewport = page.getViewport({ scale: scale });
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: ctx,
                    viewport: viewport
                };
                const renderTask = page.render(renderContext);

                renderTask.promise.then(function() {
                    pageRendering = false;
                    if (spinner) spinner.style.display = 'none';

                    if (pageNumPending !== null) {
                        renderPage(pageNumPending);
                        pageNumPending = null;
                    }
                });
            }).catch(function(err) {
                console.error('Error rendering page:', err);
                pageRendering = false;
                if (spinner) spinner.style.display = 'none';
            });

            document.getElementById('page-num').textContent = num;
            document.getElementById('prev-page').disabled = (num <= 1);
            document.getElementById('next-page').disabled = (num >= (pdfDoc ? pdfDoc.numPages : 1));
        }

        function queueRenderPage(num) {
            if (pageRendering) {
                pageNumPending = num;
            } else {
                renderPage(num);
            }
        }

        function onPrevPage() {
            if (pageNum <= 1) return;
            pageNum--;
            queueRenderPage(pageNum);
        }

        function onNextPage() {
            if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
            pageNum++;
            queueRenderPage(pageNum);
        }

        document.getElementById('prev-page').addEventListener('click', onPrevPage);
        document.getElementById('next-page').addEventListener('click', onNextPage);

        document.getElementById('zoom-in').addEventListener('click', function() {
            if (scale >= 3.0) return;
            scale += 0.2;
            queueRenderPage(pageNum);
        });

        document.getElementById('zoom-out').addEventListener('click', function() {
            if (scale <= 0.6) return;
            scale -= 0.2;
            queueRenderPage(pageNum);
        });

        // Initialize and Load Document
        pdfjsLib.getDocument(pdfUrl).promise.then(function(pdfDoc_) {
            pdfDoc = pdfDoc_;
            document.getElementById('page-count').textContent = pdfDoc.numPages;
            renderPage(pageNum);
        }).catch(function(err) {
            console.error('Error loading PDF document:', err);
            if (spinner) {
                spinner.innerHTML = '<div class="text-danger fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Unable to display document.</div>';
                spinner.style.display = 'block';
            }
        });

        // Anti-Theft: Disable Keyboard Shortcuts (Ctrl+S, Ctrl+P, Ctrl+C, etc.)
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey || e.metaKey) {
                const key = e.key.toLowerCase();
                if (key === 's' || key === 'p' || key === 'c' || key === 'u' || key === 'a') {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }
            }
            if (e.key === 'PrintScreen') {
                e.preventDefault();
            }
            // Keyboard Page Navigation
            if (e.key === 'ArrowLeft') {
                onPrevPage();
            } else if (e.key === 'ArrowRight') {
                onNextPage();
            }
        });

        // Fullscreen Toggle
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().then(() => {
                    document.body.classList.add('is-fullscreen');
                    document.getElementById('fsIcon').classList.replace('bi-arrows-fullscreen', 'bi-fullscreen-exit');
                }).catch(err => console.error(err));
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().then(() => {
                        document.body.classList.remove('is-fullscreen');
                        document.getElementById('fsIcon').classList.replace('bi-fullscreen-exit', 'bi-arrows-fullscreen');
                    });
                }
            }
        }

        document.addEventListener('fullscreenchange', () => {
            const isFs = !!document.fullscreenElement;
            const icon = document.getElementById('fsIcon');
            if (isFs) {
                document.body.classList.add('is-fullscreen');
                if (icon) icon.classList.replace('bi-arrows-fullscreen', 'bi-fullscreen-exit');
            } else {
                document.body.classList.remove('is-fullscreen');
                if (icon) icon.classList.replace('bi-fullscreen-exit', 'bi-arrows-fullscreen');
            }
        });

        // Track reading history via AJAX call
        try {
            fetch('/Reader/TrackReading?issueId=@Model.Id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).catch(e => console.log('Reading history logged'));
        } catch (e) {}
    </script>
</body>
</html>
