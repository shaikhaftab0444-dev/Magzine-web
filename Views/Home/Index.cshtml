@model Digital_Magzine.Models.StorefrontViewModel

@{
    ViewData["Title"] = "Digital Newsstand - Culture Club";
}

<style>
    /* Clean Zinio-style Storefront Styles */
    .zinio-storefront {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #111827;
        background-color: #ffffff;
    }

    /* Hide scrollbars for carousels */
    .magazine-carousel-scroll {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
        padding-bottom: 1rem;
        padding-top: 0.5rem;
    }
    .magazine-carousel-scroll::-webkit-scrollbar {
        display: none; /* Chrome, Safari and Opera */
    }

    /* Hero Banner */
    .zinio-hero-banner {
        background: linear-gradient(135deg, #f4f5f8 0%, #e9edf4 100%);
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        position: relative;
    }

    .zinio-hero-title {
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: #0f172a;
    }

    .zinio-hero-sub {
        font-size: 1.15rem;
        color: #475569;
        max-width: 540px;
        line-height: 1.5;
    }

    .hero-magazine-stack {
        position: relative;
        height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-mag-card {
        position: absolute;
        width: 170px;
        aspect-ratio: 3/4;
        border-radius: 12px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.22);
        object-fit: cover;
        border: 2px solid #ffffff;
        transition: transform 0.3s ease;
    }

    .hero-mag-card.left {
        transform: rotate(-10deg) translateX(-70px) scale(0.9);
        z-index: 1;
    }

    .hero-mag-card.center {
        transform: rotate(0deg) scale(1.05);
        z-index: 3;
    }

    .hero-mag-card.right {
        transform: rotate(10deg) translateX(70px) scale(0.9);
        z-index: 2;
    }

    /* Trust Bar */
    .zinio-trust-bar {
        background-color: #ffffff;
        border-top: 1px solid #f1f5f9;
        border-bottom: 1px solid #f1f5f9;
    }

    .trust-item-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background-color: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Magazine Cards in Carousel */
    .magazine-card-item {
        width: 200px;
        min-width: 200px;
        flex: 0 0 auto;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease;
    }

    .magazine-cover-container {
        position: relative;
        width: 100%;
        aspect-ratio: 3/4;
        border-radius: 10px;
        overflow: hidden;
        background-color: #f1f5f9;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .magazine-card-item:hover .magazine-cover-container {
        transform: translateY(-6px);
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.16);
    }

    .magazine-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .badge-price-tag {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(4px);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
    }

    .badge-category-tag {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: #0f172a;
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
    }

    .magazine-meta-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
        margin-top: 0.65rem;
        margin-bottom: 0.2rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.6em;
    }

    .magazine-meta-pub {
        font-size: 0.82rem;
        color: #64748b;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .magazine-meta-price {
        font-size: 0.95rem;
        font-weight: 700;
        color: #047857; /* Rich emerald price */
    }

    /* Carousel Nav Arrows */
    .carousel-nav-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1e293b;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .carousel-nav-btn:hover {
        background-color: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }

    /* Quick Browse Pills */
    .category-browse-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1.1rem;
        border-radius: 50px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 0.88rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .category-browse-pill:hover {
        background-color: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }
</style>

<div class="zinio-storefront">
    <!-- ========================================================================
         1. Hero Section (Wide, Light-Gray Zinio Promotional Banner)
         ======================================================================== -->
    <div class="container-fluid px-3 px-lg-5 pt-4 pb-2">
        <div class="zinio-hero-banner p-4 p-md-5">
            <div class="row align-items-center g-4">
                <!-- Left: Headline, Subtitle, CTA Button -->
                <div class="col-12 col-md-6">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold text-uppercase px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-stars me-1"></i> Special Digital Newsstand Offer
                    </span>
                    <h1 class="zinio-hero-title mb-3">
                        Unmissable Savings!
                    </h1>
                    <p class="zinio-hero-sub mb-4">
                        Save up to 75% on thousands of premier digital magazines. Unlimited instant access anytime on web, iOS, and Android.
                    </p>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        @if (User.Identity == null || !User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                                CREATE AN ACCOUNT &rarr;
                            </a>
                            <a asp-controller="Checkout" asp-action="Payment" class="btn btn-outline-dark btn-lg rounded-pill px-4 fw-semibold">
                                <i class="bi bi-gem me-1"></i> VIP Pass (@SettingsService.GetCurrencySymbol()499)
                            </a>
                        }
                        else
                        {
                            <a href="#popular-section" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                                EXPLORE MAGAZINES &rarr;
                            </a>
                            <a asp-controller="Checkout" asp-action="Payment" class="btn btn-outline-dark btn-lg rounded-pill px-4 fw-semibold">
                                <i class="bi bi-gem me-1"></i> VIP All-Access (@SettingsService.GetCurrencySymbol()499)
                            </a>
                        }
                    </div>
                </div>

                <!-- Right: Illustrative Magazine Stacks (Stacks Vertically on Mobile) -->
                <div class="col-12 col-md-6 text-center">
                    <div class="hero-magazine-stack mx-auto">
                        <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80" alt="Tech Magazine" class="hero-mag-card left" />
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80" alt="Vogue Magazine" class="hero-mag-card center" />
                        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80" alt="Business Magazine" class="hero-mag-card right" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================
         2. Trust Bar (Full-Width Horizontal Row with 4 Icons & Text)
         ======================================================================== -->
    <div class="zinio-trust-bar py-4 my-4">
        <div class="container-fluid px-3 px-lg-5">
            <div class="row g-4 text-start">
                <!-- Feature 1 -->
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="trust-item-icon">
                            <i class="bi bi-collection"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">10,000+ Digital Magazines</div>
                            <div class="text-muted small">Global titles across every passion</div>
                        </div>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="trust-item-icon">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">Read On Any Device</div>
                            <div class="text-muted small">Seamless across web, iOS & Android</div>
                        </div>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="trust-item-icon">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">Cancel Anytime</div>
                            <div class="text-muted small">No lock-ins or hidden contracts</div>
                        </div>
                    </div>
                </div>

                <!-- Feature 4 -->
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="trust-item-icon">
                            <i class="bi bi-cloud-arrow-down"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">Download & Read Offline</div>
                            <div class="text-muted small">Take your reading anywhere</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Browse Categories (Connected to Live Database) -->
    @if (Model.Categories != null && Model.Categories.Any())
    {
        <div class="container-fluid px-3 px-lg-5 mb-4">
            <div class="d-flex flex-wrap gap-2 justify-content-center py-2">
                <a href="#popular-section" class="category-browse-pill">
                    <i class="bi bi-grid-fill text-primary small"></i> All Titles
                </a>
                @foreach (var cat in Model.Categories)
                {
                    var catTarget = "cat-" + cat.Name.ToLower().Replace(" ", "-").Replace("&", "-");
                    <a href="#@catTarget" class="category-browse-pill">
                        <i class="bi bi-tag-fill text-primary small"></i> @cat.Name
                    </a>
                }
            </div>
        </div>
    }

    <!-- ========================================================================
         3. Horizontal Carousel 1: Most Popular
         ======================================================================== -->
    <section class="py-3" id="popular-section">
        <div class="container-fluid px-3 px-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>Most Popular</span>
                        <span class="badge bg-danger bg-opacity-10 text-danger fs-6 fw-semibold rounded-pill px-2">HOT</span>
                    </h2>
                    <p class="text-muted small mb-0">The top trending and most-read magazine issues this week.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="carousel-nav-btn" onclick="scrollMagazineRow('popularCarousel', -450)" title="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="carousel-nav-btn" onclick="scrollMagazineRow('popularCarousel', 450)" title="Next">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="magazine-carousel-scroll d-flex flex-nowrap overflow-auto gap-4" id="popularCarousel">
                @if (Model.MostPopular != null && Model.MostPopular.Any())
                {
                    @foreach (var issue in Model.MostPopular)
                    {
                        var coverImg = !string.IsNullOrEmpty(issue.CoverImagePath)
                            ? issue.CoverImagePath
                            : (!string.IsNullOrEmpty(issue.CoverImageUrl) ? issue.CoverImageUrl : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80");
                        var pubName = issue.Magazine?.Title ?? "Culture Club Publishing";
                        var catName = issue.Category?.Name ?? issue.Magazine?.Category?.Name ?? "General";
                        var isFree = issue.SingleIssuePrice <= 0;

                        <a href="/Magazines/Details/@issue.Id" class="magazine-card-item text-decoration-none text-dark">
                            <div class="magazine-cover-container">
                                <img src="@coverImg" alt="@issue.Title" class="magazine-cover-img" loading="lazy" />
                                <span class="badge-category-tag">@catName</span>
                                @if (isFree)
                                {
                                    <span class="badge bg-success text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                                        <i class="bi bi-gift-fill me-1"></i> FREE
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-price-tag">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                }
                            </div>
                            <div class="magazine-meta-title" title="@issue.Title">
                                @issue.Title
                            </div>
                            <div class="magazine-meta-pub">
                                @pubName
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                @if (isFree)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded-pill">FREE</span>
                                }
                                else
                                {
                                    <span class="magazine-meta-price">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                }
                                <span class="text-muted small">Vol. @issue.Volume</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="text-muted py-4">No popular magazine issues currently available.</div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================================
         4. Horizontal Carousel 2: New Arrivals
         ======================================================================== -->
    <section class="py-4 my-2" id="new-arrivals-section">
        <div class="container-fluid px-3 px-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>New Arrivals</span>
                        <span class="badge bg-success bg-opacity-10 text-success fs-6 fw-semibold rounded-pill px-2">FRESH</span>
                    </h2>
                    <p class="text-muted small mb-0">Just added to our digital newsstand. Stay ahead with the latest releases.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="carousel-nav-btn" onclick="scrollMagazineRow('newArrivalsCarousel', -450)" title="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="carousel-nav-btn" onclick="scrollMagazineRow('newArrivalsCarousel', 450)" title="Next">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="magazine-carousel-scroll d-flex flex-nowrap overflow-auto gap-4" id="newArrivalsCarousel">
                @if (Model.NewArrivals != null && Model.NewArrivals.Any())
                {
                    @foreach (var issue in Model.NewArrivals)
                    {
                        var coverImg = !string.IsNullOrEmpty(issue.CoverImagePath)
                            ? issue.CoverImagePath
                            : (!string.IsNullOrEmpty(issue.CoverImageUrl) ? issue.CoverImageUrl : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80");
                        var pubName = issue.Magazine?.Title ?? "Culture Club Publishing";
                        var catName = issue.Category?.Name ?? issue.Magazine?.Category?.Name ?? "General";
                        var isFree = issue.SingleIssuePrice <= 0;

                        <a href="/Magazines/Details/@issue.Id" class="magazine-card-item text-decoration-none text-dark">
                            <div class="magazine-cover-container">
                                <img src="@coverImg" alt="@issue.Title" class="magazine-cover-img" loading="lazy" />
                                <span class="badge-category-tag">@catName</span>
                                @if (isFree)
                                {
                                    <span class="badge bg-success text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                                        <i class="bi bi-gift-fill me-1"></i> FREE
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-price-tag">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                }
                            </div>
                            <div class="magazine-meta-title" title="@issue.Title">
                                @issue.Title
                            </div>
                            <div class="magazine-meta-pub">
                                @pubName
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                @if (isFree)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded-pill">FREE</span>
                                }
                                else
                                {
                                    <span class="magazine-meta-price">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                }
                                <span class="text-muted small">@issue.PublishDate.ToString("MMM yyyy")</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="text-muted py-4">No new arrivals currently available.</div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================================
         5. Dynamic Connected Category Sections (Database Driven)
         ======================================================================== -->
    @if (Model.IssuesByCategory != null && Model.IssuesByCategory.Any())
    {
        @foreach (var catGroup in Model.IssuesByCategory)
        {
            var carouselId = "catCarousel_" + catGroup.Key.Replace(" ", "_").Replace("&", "_");
            var catTargetId = "cat-" + catGroup.Key.ToLower().Replace(" ", "-").Replace("&", "-");
            <section class="py-3 my-2" id="@catTargetId">
                <div class="container-fluid px-3 px-lg-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <span>@catGroup.Key Editions</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary fs-6 fw-semibold rounded-pill px-2">@catGroup.Value.Count Issues</span>
                            </h2>
                            <p class="text-muted small mb-0">Curated in-house publications and special issues in @catGroup.Key.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="carousel-nav-btn" onclick="scrollMagazineRow('@carouselId', -450)" title="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button class="carousel-nav-btn" onclick="scrollMagazineRow('@carouselId', 450)" title="Next">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <div class="magazine-carousel-scroll d-flex flex-nowrap overflow-auto gap-4" id="@carouselId">
                        @foreach (var issue in catGroup.Value)
                        {
                            var coverImg = !string.IsNullOrEmpty(issue.CoverImagePath)
                                ? issue.CoverImagePath
                                : (!string.IsNullOrEmpty(issue.CoverImageUrl) ? issue.CoverImageUrl : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80");
                            var pubName = issue.Magazine?.Title ?? "Culture Club Publishing";
                            var isFree = issue.SingleIssuePrice <= 0;

                            <a href="/Magazines/Details/@issue.Id" class="magazine-card-item text-decoration-none text-dark">
                                <div class="magazine-cover-container">
                                    <img src="@coverImg" alt="@issue.Title" class="magazine-cover-img" loading="lazy" />
                                    <span class="badge-category-tag">@catGroup.Key</span>
                                    @if (isFree)
                                    {
                                        <span class="badge bg-success text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                                            <i class="bi bi-gift-fill me-1"></i> FREE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-price-tag">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                    }
                                </div>
                                <div class="magazine-meta-title" title="@issue.Title">
                                    @issue.Title
                                </div>
                                <div class="magazine-meta-pub">
                                    @pubName
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    @if (isFree)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded-pill">FREE</span>
                                    }
                                    else
                                    {
                                        <span class="magazine-meta-price">@SettingsService.GetCurrencySymbol()@issue.SingleIssuePrice.ToString("0.##")</span>
                                    }
                                    <span class="text-muted small">Vol. @issue.Volume</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }
    }

    <!-- Mid-Page Digital Experience Banner -->
    <div class="container-fluid px-3 px-lg-5 my-5">
        <div class="card border-0 rounded-4 p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #111827 0%, #1e293b 100%);">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge bg-warning text-dark fw-bold mb-2">ALL-ACCESS PASS</span>
                    <h3 class="fw-bold mb-2">Read Every Issue Seamlessly In Ultra HD</h3>
                    <p class="text-white-50 mb-0">Experience interactive digital replicas, crystal clear typography, audio narration, and offline reading on any device.</p>
                </div>
                <div class="col-lg-5 text-lg-end d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Checkout" asp-action="Payment" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                        <i class="bi bi-gem me-1"></i> Get All-Access Pass (@SettingsService.GetCurrencySymbol()499)
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                        Join Free &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function scrollMagazineRow(id, distance) {
        const el = document.getElementById(id);
        if (el) {
            el.scrollBy({ left: distance, behavior: 'smooth' });
        }
    }
</script>
